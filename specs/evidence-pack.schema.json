{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motionvideopipeline://schemas/evidence-pack.schema.json",
  "title": "EvidencePack",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectId", "sources", "claims"],
  "properties": {
    "projectId": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "items": { "type": "object", "required": ["sourceId", "url", "fetchedAt", "status", "contentType", "text", "sha256"], "additionalProperties": false, "properties": { "sourceId": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "fetchedAt": { "type": "string", "format": "date-time" }, "status": { "type": "integer" }, "contentType": { "type": "string" }, "text": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
    "claims": { "type": "array", "items": { "type": "object", "required": ["claimId", "subject", "field", "value", "sourceRefs", "evidenceQuote", "capturedAt", "confidence", "status"], "additionalProperties": false, "properties": { "claimId": { "type": "string" }, "subject": { "type": "string" }, "field": { "type": "string" }, "value": {}, "sourceRefs": { "type": "array", "items": { "type": "string" } }, "evidenceQuote": { "type": "string" }, "capturedAt": { "type": "string", "format": "date-time" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "status": { "enum": ["verified", "conflict", "insufficient", "hypothesis"] } } } }
  }
}
