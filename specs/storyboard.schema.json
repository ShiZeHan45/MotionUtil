{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motionvideopipeline://schemas/storyboard.schema.json",
  "title": "StoryboardSchema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "title", "domainId", "chapters", "durationLimitMs"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "projectId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "domainId": { "type": "string", "minLength": 1 },
    "durationLimitMs": { "type": "integer", "const": 300000 },
    "chapters": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "beats"],
        "properties": {
          "id": { "enum": ["opening", "principle", "case", "application", "conclusion"] },
          "title": { "type": "string" },
          "beats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "spokenText", "subtitleText", "visualActions", "evidenceRefs", "textBudget"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
                "kind": { "enum": ["narration", "transition", "hook"] },
                "spokenText": { "type": "string", "minLength": 1, "maxLength": 800 },
                "displayText": { "type": "string", "minLength": 1, "maxLength": 800 },
                "pronunciationText": { "type": "string", "minLength": 1, "maxLength": 800 },
                "pronunciationTokens": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["source", "spoken", "kind"],
                    "properties": {
                      "source": { "type": "string", "minLength": 1 },
                      "spoken": { "type": "string", "minLength": 1 },
                      "kind": { "enum": ["plain", "english-proper-name", "acronym", "integer", "decimal", "percentage", "version", "date", "code", "url"] },
                      "dictionaryRef": { "type": "string" }
                    }
                  }
                },
                "subtitleText": { "type": "string", "minLength": 1, "maxLength": 80 },
                "audioPath": { "type": "string" },
                "durationMs": { "type": "integer", "minimum": 1 },
                "visualActions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "durationFrames"],
                    "properties": {
                      "type": { "enum": ["draw-node", "connect", "emphasize", "camera-pan", "camera-zoom", "transform", "hold", "clear-zone", "evidence-window"] },
                      "target": { "type": "string" },
                      "from": { "type": "string" },
                      "to": { "type": "string" },
                      "durationFrames": { "type": "integer", "minimum": 1 },
                      "parallelGroup": { "type": "string" },
                      "after": { "type": "string" },
                      "params": { "type": "object" }
                    }
                  }
                },
                "evidenceRefs": { "type": "array", "items": { "type": "string" } },
                "hookRefs": { "type": "array", "items": { "type": "string" } },
                "textBudget": { "type": "object", "additionalProperties": false, "required": ["maxChars"], "properties": { "maxChars": { "type": "integer", "minimum": 1, "maximum": 800 } } }
              }
            }
          }
        }
      }
    }
  },
  "x-runtimeRules": [
    "chapters 必须按五个可见章节固定顺序出现",
    "只有 conclusion 的最后一个 beat 可以 kind=hook；hook 不得出现在其他章节",
    "每个 beat 的动作总帧数不得超过其音频实际帧数",
    "audioPath 生成前允许为空，进入渲染节点前必须存在且 durationMs 必须来自音频文件帧数",
    "每个事实、数字、案例和限制必须通过 evidenceRefs 引用 EvidencePack；无法引用时标记为假设并阻断事实型表述",
    "displayText 用于字幕和画面，pronunciationText 用于 Kokoro；二者必须通过 pronunciationTokens 保留映射",
    "英文 token 无发音词典或 phoneme hint 时必须产生诊断并阻断配音；整数 token 必须使用中文单位读法",
    "subtitleText 必须在两行内显示，单行不超过18个汉字或等价 token"
  ]
}
