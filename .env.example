# GitHub API token is optional for a small weekly run, but recommended for rate limits.
GITHUB_TOKEN=
# 节点 2 获取的周榜项目数量（1–20）。
GITHUB_TOP_N=5

# Any OpenAI-compatible chat completions service can be used for script generation.
OPENAI_BASE_URL=https://api.buzzai.cc/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# 留空为自动；也可设置 low / medium / high / xhigh。桌面端设置页可直接选择。
OPENAI_REASONING_EFFORT=

# Kokoro TTS: install Kokoro and misaki[zh] in an isolated Python environment.
# Point this to that environment's Python executable.
KOKORO_PYTHON=.venv-kokoro/Scripts/python.exe
KOKORO_MODEL=hexgrad/Kokoro-82M-v1.1-zh
KOKORO_VOICE=zf_001
KOKORO_DEVICE=cpu
KOKORO_SPEED=1.0
KOKORO_PAUSE_MS=200
KOKORO_CACHE_DIR=.cache/kokoro

# Paths must be installed locally and are not bundled in this project.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional: use a looping MP4/GIF/image background. Leave empty for a plain white background.
# GIF files are converted to MP4 automatically before rendering.
VIDEO_BACKGROUND_PATH=

# Optional: use an already installed Chrome/Chromium instead of downloading Remotion's browser.
REMOTION_BROWSER_EXECUTABLE=
